{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slaif-release-provenance-v3",
  "title": "SLAIF Local Coding release/deployment provenance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "objective",
    "generated_from",
    "gateway_peer",
    "runtime",
    "artifacts",
    "templates",
    "oci",
    "reference_compatibility",
    "status",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "slaif-release-provenance-v3"
    },
    "schema_version": {
      "const": 3
    },
    "objective": {
      "type": "string",
      "pattern": "^[0-9]{3}-[a-z]{1,2}$"
    },
    "generated_from": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "git_commit"
      ],
      "properties": {
        "repository": {
          "const": "ulfe-lmi/slaif-local-coding"
        },
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "gateway_peer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "server_module",
        "client_module"
      ],
      "properties": {
        "repository": {
          "const": "ulfe-lmi/slaif-api-gateway"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "server_module": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "module_id",
            "module_version",
            "replay_mode"
          ],
          "properties": {
            "module_id": {
              "type": "string",
              "minLength": 1
            },
            "module_version": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "replay_mode": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "client_module": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "module_id",
            "module_version"
          ],
          "properties": {
            "module_id": {
              "type": "string",
              "minLength": 1
            },
            "module_version": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "package_name",
        "package_version",
        "uv_lock_sha256",
        "pyproject_sha256"
      ],
      "properties": {
        "python": {
          "type": "string",
          "pattern": "^3\\.(1[2-9]|[2-9][0-9])(\\.[0-9]+)?$"
        },
        "package_name": {
          "const": "slaif-local-coding"
        },
        "package_version": {
          "type": "string",
          "minLength": 1
        },
        "uv_lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pyproject_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wheel",
        "sdist"
      ],
      "properties": {
        "wheel": {
          "$ref": "#/$defs/artifact"
        },
        "sdist": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_example_sha256",
        "deployment_config_template_sha256",
        "gateway_integrated_config_template_sha256",
        "service_unit_sha256",
        "service_unit_example_sha256",
        "readyz_wait_sha256"
      ],
      "properties": {
        "config_example_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "deployment_config_template_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "gateway_integrated_config_template_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "service_unit_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "service_unit_example_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "readyz_wait_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "oci": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_reference",
        "tag_convention",
        "base_image",
        "build_base_image",
        "dockerfile_sha256",
        "compose_sha256",
        "dockerignore_sha256",
        "wheel_sha256",
        "image_digest",
        "published",
        "labels",
        "build_tool_image"
      ],
      "properties": {
        "image_reference": {
          "const": "ghcr.io/ulfe-lmi/slaif-local-coding"
        },
        "tag_convention": {
          "type": "string",
          "minLength": 1
        },
        "base_image": {
          "$ref": "#/$defs/base_image"
        },
        "build_base_image": {
          "$ref": "#/$defs/base_image"
        },
        "dockerfile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "compose_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dockerignore_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "wheel_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "image_digest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          ]
        },
        "published": {
          "enum": [
            false,
            true
          ]
        },
        "labels": {
          "$ref": "#/$defs/oci_labels"
        },
        "build_tool_image": {
          "$ref": "#/$defs/base_image"
        }
      }
    },
    "reference_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_name",
        "upstream_interface",
        "codex_client"
      ],
      "properties": {
        "model_name": {
          "const": "qwen3.8-27b"
        },
        "upstream_interface": {
          "const": "vllm-openai-compat-v1"
        },
        "codex_client": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "wire_fixture_dir"
          ],
          "properties": {
            "version": {
              "const": "0.149.0"
            },
            "wire_fixture_dir": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_qualified",
        "cutover_performed",
        "released"
      ],
      "properties": {
        "deployment_qualified": {
          "const": "disposable-environment-only"
        },
        "cutover_performed": {
          "const": false
        },
        "released": {
          "enum": [
            false,
            true
          ]
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "git_tag",
        "git_tag_target",
        "image_source_commit",
        "oci_image_digest",
        "oci_tags",
        "published_at",
        "publication_workflow_run_id"
      ],
      "properties": {
        "version": {
          "const": "0.1.0"
        },
        "git_tag": {
          "const": "v0.1.0"
        },
        "git_tag_target": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "image_source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "oci_image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "oci_tags": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "published_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "publication_workflow_run_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256",
        "size_bytes",
        "entry_count"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "entry_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "base_image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "oci_labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "org.opencontainers.image.source",
        "org.opencontainers.image.version",
        "slaif-local-coding.package.version",
        "slaif-local-coding.gateway.peer.sha",
        "slaif-local-coding.topology.mode",
        "slaif-local-coding.qualification",
        "slaif-local-coding.wheel.sha256"
      ],
      "properties": {
        "org.opencontainers.image.source": {
          "const": "https://github.com/ulfe-lmi/slaif-local-coding"
        },
        "org.opencontainers.image.version": {
          "type": "string",
          "minLength": 1
        },
        "slaif-local-coding.package.version": {
          "type": "string",
          "minLength": 1
        },
        "slaif-local-coding.gateway.peer.sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "slaif-local-coding.topology.mode": {
          "type": "string",
          "minLength": 1
        },
        "slaif-local-coding.qualification": {
          "type": "string",
          "minLength": 1
        },
        "slaif-local-coding.wheel.sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
