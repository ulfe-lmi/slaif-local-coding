{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slaif-release-provenance-v1",
  "title": "SLAIF Local Coding release/deployment provenance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "objective",
    "generated_from",
    "gateway_peer",
    "runtime",
    "artifacts",
    "templates",
    "reference_compatibility",
    "status",
    "limitations"
  ],
  "properties": {
    "schema": {"const": "slaif-release-provenance-v1"},
    "schema_version": {"const": 1},
    "objective": {"const": "009-a"},
    "generated_from": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "git_commit"],
      "properties": {
        "repository": {"const": "ulfe-lmi/slaif-local-coding"},
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "gateway_peer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "server_module", "client_module"],
      "properties": {
        "repository": {"const": "ulfe-lmi/slaif-api-gateway"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "server_module": {
          "type": "object",
          "additionalProperties": false,
          "required": ["module_id", "module_version", "replay_mode"],
          "properties": {
            "module_id": {"type": "string", "minLength": 1},
            "module_version": {"type": "string", "pattern": "^[0-9]+$"},
            "replay_mode": {"type": "string", "minLength": 1}
          }
        },
        "client_module": {
          "type": "object",
          "additionalProperties": false,
          "required": ["module_id", "module_version"],
          "properties": {
            "module_id": {"type": "string", "minLength": 1},
            "module_version": {"type": "string", "pattern": "^[0-9]+$"}
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "package_name",
        "package_version",
        "uv_lock_sha256",
        "pyproject_sha256"
      ],
      "properties": {
        "python": {"type": "string", "pattern": "^3\\.(1[2-9]|[2-9][0-9])(\\.[0-9]+)?$"},
        "package_name": {"const": "slaif-local-coding"},
        "package_version": {"type": "string", "minLength": 1},
        "uv_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pyproject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wheel", "sdist"],
      "properties": {
        "wheel": {"$ref": "#/$defs/artifact"},
        "sdist": {"$ref": "#/$defs/artifact"}
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_example_sha256",
        "deployment_config_template_sha256",
        "service_unit_sha256",
        "service_unit_example_sha256",
        "readyz_wait_sha256"
      ],
      "properties": {
        "config_example_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "deployment_config_template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "service_unit_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "service_unit_example_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "readyz_wait_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "reference_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_name", "upstream_interface", "codex_client"],
      "properties": {
        "model_name": {"const": "qwen3.8-27b"},
        "upstream_interface": {"const": "vllm-openai-compat-v1"},
        "codex_client": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "wire_fixture_dir"],
          "properties": {
            "version": {"const": "0.149.0"},
            "wire_fixture_dir": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployment_qualified", "cutover_performed", "released"],
      "properties": {
        "deployment_qualified": {"const": "disposable-environment-only"},
        "cutover_performed": {"const": false},
        "released": {"const": false}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "size_bytes", "entry_count"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "entry_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
