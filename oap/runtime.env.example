# Copy/edit through oap/bin/bootstrap-two-codex-oap.sh.
OAP_REPO_ROOT=/synology/homes/janezp/codex-work/slaif-local-coding
OAP_STRATEGIC_HOME=/synology/homes/janezp/codex-supervision/slaif-local-coding
